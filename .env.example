# ============================================================
# WebObsidian: copy to .env and edit, then `docker compose up -d --build`
#   cp .env.example .env
# .env is git-ignored, so your settings survive `git pull` / redeploys.
# ============================================================

# --- Docker deploy (docker compose) -------------------------
# Host path to your vault, bind-mounted to /vault inside the container.
# Absolute path, or relative to this compose file. The directory MUST exist.
# Defaults to the bundled ./sample-vault so the stack boots out of the box.
VAULT_HOST_PATH=./sample-vault

# Where to publish the web UI. Set HTTP_BIND=127.0.0.1 to expose only to
# localhost (e.g. behind an nginx/Caddy reverse proxy with TLS), so the proxy is
# the only path in and nothing else on the network can reach the app beside it.
# Worth doing for any internet-facing deployment, independently of TRUST_PROXY.
HTTP_BIND=0.0.0.0
HTTP_PORT=8787

# Proxy trust. Default "true" (trust the immediate hop) so X-Forwarded-Proto-based
# HTTPS cookie detection works behind a TLS-terminating reverse proxy out of the
# box. Accepts "true" / "false" / a hop count ("1") / a subnet or preset list
# (e.g. "loopback" or "10.1.2.3/32").
#
# It also decides how the rate limiters (login, share unlock, failed API keys)
# identify a client, and there the rule is narrower than Express's own, because
# only one of the four forms proves anything about who the peer actually is:
#
#   a subnet or preset list  ->  one bucket per client
#       Express tests the ADDRESS of every hop and stops at the first one outside
#       the list, so an entry a client wrote into X-Forwarded-For itself is
#       discarded and the limiters use the resulting address as-is. This form
#       validates itself: a direct connection from an address outside the list
#       truncates at the socket address, so naming the wrong range costs
#       precision, not safety.
#       The precondition, and it is the whole of it: the range must contain your
#       proxies and NOTHING ELSE. A range broad enough to also cover real clients
#       (say a "/12" that happens to include the LAN sitting behind the proxy)
#       means those clients' own X-Forwarded-For entries are believed, and each
#       can mint a fresh rate-limit bucket per request. Prefer the narrowest
#       range you can name, a /32 when the proxy has one fixed address. In docker
#       the peer is the proxy's address on the container network, not 127.0.0.1,
#       so "loopback" is wrong there: read the real one off
#       `docker network inspect <network>`.
#
#   "true" (the default), "false", or ANY hop count including "1"
#       All three key on the raw TCP socket address, which a client cannot forge,
#       so rotating X-Forwarded-For mints nothing. A hop count is NOT a shortcut
#       to per-client buckets: for that form Express only counts hops and never
#       checks who the peer is, so the limiters do not use its answer at all and
#       it behaves exactly like the default here. (It still changes req.ip and
#       req.secure for everything else in the app.)
#       The cost is real and worth knowing: behind a reverse proxy every visitor
#       arrives from the proxy's own address, so they all share one bucket. "10
#       login attempts per 15 minutes" is an instance-wide budget, and ten failed
#       logins from a stranger do keep the owner out for the rest of the window.
#       That is an availability cost, not a bypass, and it is bounded: refused
#       attempts are not recorded, so the lockout always expires 15 minutes after
#       the tenth accepted attempt no matter how hard someone keeps hammering.
#
# Which to pick: leaving this at "true" is safe, and on a single-user instance the
# shared bucket is a self-healing annoyance rather than a breach. Move to the
# subnet form when you can name your proxy's address exactly and you want the
# login limit to apply per visitor. Do not set a broad range merely to get off the
# default: a range that contains clients is worse than the default.
TRUST_PROXY=true

# Initial master password. Leave empty to set it on first-run via the UI.
WEBOBSIDIAN_PASSWORD=

# File-watch mode:
#   auto    (default) native inotify, auto-falls back to polling if the host's
#           inotify watch limit is exceeded by a large vault.
#   polling force polling (no inotify; works anywhere, higher CPU).
# For large vaults, prefer raising the host limit over polling:
#   sudo sysctl -w fs.inotify.max_user_watches=524288
WEBOBSIDIAN_WATCH=auto

# --- Bare-metal only (npm run start, without docker) --------
# The container sets these itself; uncomment only when running outside docker.
# PORT=8787
# HOST=0.0.0.0          # 127.0.0.1 = reachable only through a local reverse
#                       # proxy. The bare-metal equivalent of HTTP_BIND.
# TRUST_PROXY=true      # see the block above before changing this
# VAULT_PATH=./sample-vault
# DATA_DIR=./data
# ALLOWED_ROOTS=
# NODE_ENV=production

# The origin(s) users actually type into the browser, comma-separated, e.g.
# "https://notes.example.com". Only the /ws WebSocket upgrade reads it: when set,
# it is the exact allowlist the handshake's Origin header is matched against, and
# no Host / X-Forwarded-Host guessing happens at all. Leave it unset if your proxy
# already forwards the original Host (see the README's nginx block). Set it when
# the log shows "[security] WebSocket upgrade refused" or "allowed even though
# this server sees Host=...", both of which name it as the remedy. It grants
# nothing: unlike DEV_CORS_ORIGIN below it does not let anyone read the API
# cross-site, it only declares which front doors are your own.
# PUBLIC_ORIGIN=https://notes.example.com

# Cross-origin API access for a development front end, e.g. a Vite dev server on
# a different host. Leave UNSET in production: CORS is off unless this names a
# single exact origin (no "*", no comma-separated list, both are refused with a
# log line). `npm run dev` does not need it because Vite proxies /api, /auth,
# /public, /share and /ws, which makes the browser see one origin.
# DEV_CORS_ORIGIN=http://192.168.1.10:5173
